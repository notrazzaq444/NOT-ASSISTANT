# --- Required ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Optional ---
# Where the SQLite DB lives. On Render, point this at a mounted disk if you
# want conversations to survive redeploys.
DB_PATH=not.db

# Request tuning
OPENAI_TIMEOUT=60
MAX_MESSAGE_CHARS=8000
MAX_HISTORY_MESSAGES=40
MAX_CONVERSATION_MESSAGES=500

# Rate limiting (per IP, in-memory)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Comma-separated list of allowed origins, or "*" for local dev.
# For a public deploy, set this to your site's exact origin(s).
CORS_ORIGINS=*

# If set, clients must send header "X-Access-Token: <value>".
# Use this to stop anonymous visitors from burning your API credits.
# Leave blank for local development.
ACCESS_TOKEN=

# Optional system prompt override
# SYSTEM_PROMPT=You are NOT...